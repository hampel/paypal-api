# Copy this file to .env beside the package. The rig loads it - unless an agent is running the
# command, in which case it deliberately does not; see harness/lib/harness.php.
#
# Every exercise reads and changes nothing. What matters is WHICH ACCOUNT it reads: use a sandbox
# app, from the Apps & Credentials page of PayPal's developer dashboard, with sandbox accounts to
# make test purchases from.

# A REST app's credentials. Tick Transaction Search in the app's features, or the transactions,
# payments and subscriptions exercises are refused.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# sandbox (the default) or live. Live is refused unless PAYPAL_LIVE is also exactly 1 - and a live
# app's credentials read real payers' names, emails and money.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_LIVE=

# Optional. How many days back the exercises search, 31 by default.
PAYPAL_HARNESS_DAYS=

# Optional. The most captures and refunds the payments exercise looks up, 10 by default.
PAYPAL_HARNESS_LOOKUPS=

# Optional. A subscription for the subscriptions exercise to read when the window holds no
# subscription payment - an id beginning I-.
PAYPAL_SUBSCRIPTION_ID=

# Optional. The webhook the webhooks exercise verifies a forged notification against; the first
# registered webhook when empty.
PAYPAL_WEBHOOK_ID=

# One more variable the harness reads is deliberately not listed above, because this file is meant
# to be copied to .env and it must never live in one:
#
#   PAYPAL_AGENT_MAY_READ_LIVE=1     an agent may read the live account, this once
#
# PAYPAL_LIVE is otherwise ignored when CLAUDECODE is set - it is read from a file written by
# whoever owns the account, and an agent would inherit an authorisation nobody gave it. Put the
# override on the command line for one run, when the account's owner has said so.
